---
# yamllint configuration for the Ansible playbooks and roles under
# infra/ansible/. The default line-length cap of 80 chars is too tight
# for idiomatic Ansible (URLs, package lists, jinja expressions, multi-
# argument shell commands inline), so we lift the limit to 200 and treat
# anything beyond that as a real warning. Other rules stay on default.
extends: default

rules:
  line-length:
    max: 200
    level: warning
  truthy:
    allowed-values: ["true", "false", "yes", "no"]
